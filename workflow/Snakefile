## Caitlin's notes
# Run script from dir that contains chromatin-assembly dir (not from within chromatin-assembly/)

# --- Config file --- #
configfile: "config/chromatin_assembly_config.yml"


# --- Global Variables --- #
# SAMPLE_IDS – unique identifiers of reads to process
SAMPLE_IDS  = config["input"]["sample_ids"]

# REF_SPECIES – Reference species name 
REF_SPECIES = config["ref_species"]
# REF_GENOME_ID –Human readable name for reference genome, to be included in output files
REF_GENOME_ID = config["input"]["reference_genome_id"]

# OUTDIR – Output directory for given reference species
OUTDIR = config["repo_dir"] + "results/" + config["ref_species"] + "/"

# S1_INPUT_READ_DIR – location of reads (merged or processed), to be input into Step 1
S1_INPUT_READ_DIR = config["input"]["input_dir"]

# KALIGN_ID – text snipped to include in output files generated by kalign
KALIGN_ID = config["s4_read_alignment"]["kalign_id"]

# ADAPTERS – for use with RepeatMasker in Step 1
ADAPTERS = config["repo_dir"] + config["params"]["adapters"] # adapters file path

# INPUT_CONTROL_NAME - Human-readable identifier for input control. Used for naming DANPOS output directories and files
INPUT_CONTROL_NAME = config["input_control"]["control_name"]
# INPUT_CONTROL_SAMPLES - samples used as input control with DANPOS (Step 8)
INPUT_CONTROL_SAMPLES = config["input_control"]["control_samples"]

# STEP{X}_NAME – name for output directory for each step of the pipeline, where {X} is the step number
STEP0_NAME = config["output_dir"]["step0"]
STEP1_NAME = config["output_dir"]["step1"]
STEP2_NAME = config["output_dir"]["step2"]
STEP3_NAME = config["output_dir"]["step3"]
STEP4_NAME = config["output_dir"]["step4"]
STEP5_NAME = config["output_dir"]["step5"]
STEP6a_NAME = config["output_dir"]["step6a"]
STEP6b_NAME = config["output_dir"]["step6b"]
STEP6c_NAME = config["output_dir"]["step6c"]
STEP6d_NAME = config["output_dir"]["step6d"]
STEP7a_NAME = config["output_dir"]["step7a"]
STEP7b_NAME = config["output_dir"]["step7b"]
STEP8_NAME = config["output_dir"]["step8"]


# --- Complete pipeline run --- #
## Run all rules
# To generate files for s0_merge_samples:
#        s0_r1      = expand("{outdir}{step_name}/{sample}_merged_R1.fastq.gz", outdir=OUTDIR, step_name=STEP0_NAME, sample=SAMPLE_IDS),
#        s0_r2      = expand("{outdir}{step_name}/{sample}_merged_R2.fastq.gz", outdir=OUTDIR, step_name=STEP0_NAME, sample=SAMPLE_IDS),
rule run_all:
    input:
        s1_masked  = expand("{outdir}{step_name}/{ref_genome_id}.masked", outdir=OUTDIR, step_name=STEP1_NAME, ref_genome_id=REF_GENOME_ID),
        s1_index   = expand("{outdir}{step_name}/{ref_genome_id}.masked.index", outdir=OUTDIR, step_name=STEP1_NAME, ref_genome_id=REF_GENOME_ID),
        s2_r1      = expand("{outdir}{step_name}/{sample}_merged_R1_fastqc.html", outdir=OUTDIR, step_name=STEP2_NAME, sample=SAMPLE_IDS),
        s2_r2      = expand("{outdir}{step_name}/{sample}_merged_R2_fastqc.html", outdir=OUTDIR, step_name=STEP2_NAME, sample=SAMPLE_IDS),
        s3_r1      = expand("{outdir}{step_name}/{sample}_merged_withUMI_R1.fastq.gz", outdir=OUTDIR, step_name=STEP3_NAME, sample=SAMPLE_IDS),
        s3_r2      = expand("{outdir}{step_name}/{sample}_merged_withUMI_R2.fastq.gz", outdir=OUTDIR, step_name=STEP3_NAME, sample=SAMPLE_IDS),
        s4_algnmt  = expand("{outdir}{step_name}/{sample}_kalign_{kalign_id}_alignment.sam", outdir=OUTDIR, step_name=STEP4_NAME, sample=SAMPLE_IDS, kalign_id=KALIGN_ID),
        s5_dedup   = expand("{outdir}{step_name}/{sample}_alignment_dedup.bam", outdir=OUTDIR, step_name=STEP5_NAME, sample=SAMPLE_IDS),
        s6a_2bit   = expand("{outdir}{step_name}/{ref_genome_id}_alignment_dedup.2bit", outdir=OUTDIR, step_name=STEP6a_NAME, ref_genome_id=REF_GENOME_ID),
        s6b_gSize  = expand("{outdir}{step_name}/{ref_genome_id}_effGenSize.txt", outdir=OUTDIR, step_name=STEP6b_NAME, ref_genome_id=REF_GENOME_ID),
        s6c_GCfreq = expand("{outdir}{step_name}/{sample}_computeGCbias.txt", outdir=OUTDIR, step_name=STEP6c_NAME, sample=SAMPLE_IDS),
        s6d_GCbias = expand("{outdir}{step_name}/{sample}_alignment_dedup_gcCorrected.bam", outdir=OUTDIR, step_name=STEP6d_NAME, sample=SAMPLE_IDS),
        s7a_metric = expand("{outdir}{step_name}/{ref_species}_{sample}_insert_size_metrics.txt", outdir=OUTDIR, step_name=STEP7a_NAME, ref_species=REF_SPECIES, sample=SAMPLE_IDS),
        s7b_stats  = expand("{outdir}{step_name}/{ref_species}_{sample}_count.txt", outdir=OUTDIR, step_name=STEP7b_NAME, ref_species=REF_SPECIES, sample=SAMPLE_IDS),
        s8_dpos    = expand("{outdir}{step_name}/{sample}/dtriple/{sample}-{input_control_name}.positions.integrative.xls", outdir=OUTDIR, step_name=STEP8_NAME, sample=SAMPLE_IDS, input_control_name=INPUT_CONTROL_NAME),
        s8_dpeak   = expand("{outdir}{step_name}/{sample}/dtriple/{sample}-{input_control_name}.peaks.integrative.xls", outdir=OUTDIR, step_name=STEP8_NAME, sample=SAMPLE_IDS, input_control_name=INPUT_CONTROL_NAME),
        s8_dregion = expand("{outdir}{step_name}/{sample}/dtriple/{sample}-{input_control_name}.regions.integrative.xls", outdir=OUTDIR, step_name=STEP8_NAME, sample=SAMPLE_IDS, input_control_name=INPUT_CONTROL_NAME)


# --- Pipeline steps --- #
## Step 0: Read collation (SLURM_MergeSamples.sh)
rule s0_merge_samples:
    input:
        config = config["repo_dir"] + "config/chromatin_assembly_config.yml"
    output:
        r1 = expand("{outdir}{step_name}/{sample}_merged_R1.fastq.gz", outdir=OUTDIR, step_name=STEP0_NAME, sample=SAMPLE_IDS),
        r2 = expand("{outdir}{step_name}/{sample}_merged_R2.fastq.gz", outdir=OUTDIR, step_name=STEP0_NAME, sample=SAMPLE_IDS)
    params:
        merge_reads  = config["merge_reads"]["perform_merge"],
        merge_script = config["repo_dir"] + "workflow/R/s0_merge_reads.R",
        repo_dir     = config["repo_dir"],
        log = config["repo_dir"] + "log/" +  config["output_dir"]["step0"] + "_" + REF_SPECIES + ".txt",
        module_R     = config["modules"]["R"]
    shell:
        """
        module load {params.module_R}

        Rscript {params.merge_script} repo_dir={params.repo_dir} config={input.config} out={params.log}
        """

## Step 1: Repeat masking with RepeatMasker and suffix array (slurm_waterdragon_RM.sh)
# Original suffix array command:  ngskit4b index -i EWD_hifiasm_HiC.fasta.masked -o EWD_hifiasm_HiC.fasta.masked -r waterdragon
rule s1_mask_repeats:
    input:
        ref_genome = config["input"]["reference_genome_path"]
    output:
        masked = OUTDIR + STEP1_NAME + "/" + REF_GENOME_ID + ".masked",
        index  = OUTDIR + STEP1_NAME + "/" + REF_GENOME_ID + ".masked.index"
    params:
        outdir              = OUTDIR + STEP1_NAME + "/",
        adapter             = ADAPTERS,
        ref_species         = REF_SPECIES, 
        log                 = OUTDIR + STEP1_NAME + "/index_logs.log",
        repeatmasker_engine = config["s1_mask_repeats"]["repeatmasker_engine"],
        module_repeatmasker = config["modules"]["repeatmasker"],
        module_kit4b        = config["modules"]["kit4b"]
    shell:
        """
        module load {params.module_repeatmasker}
        module load {params.module_kit4b}
        mkdir -p {params.outdir}

        RepeatMasker -pa {threads} -qq -dir {params.outdir} -lib {params.adapter} {input.ref_genome} {params.repeatmasker_engine}
        ngskit4b index -i {output.masked} -o {output.index} -r '{params.ref_species}' -T {threads} -F {params.log}
        """

## Step 2: Perform quality control using FastQC (slurm_fastqc.sh)
rule s2_raw_read_QC:
    input:
        r1 = OUTDIR + STEP0_NAME + "/" + "{sample}_merged_R1.fastq.gz",
        r2 = OUTDIR + STEP0_NAME + "/" + "{sample}_merged_R2.fastq.gz"
    output:
        r1 = OUTDIR + STEP2_NAME + "/" + "{sample}_merged_R1_fastqc.html",
        r2 = OUTDIR + STEP2_NAME + "/" + "{sample}_merged_R2_fastqc.html"
    params:
        outdir        = OUTDIR + STEP2_NAME + "/",
        module_fastqc = config["modules"]["fastqc"]
    shell:
        """
        module load {params.module_fastqc}
        mkdir -p {params.outdir}

        fastqc -t {threads} {input.r1} {input.r2} -o {params.outdir}
        """

## Step 3: UMI extraction with FGBio and Picard (slurm_extractUMI.sh)
rule s3_extract_UMI:
    input:
        r1 = OUTDIR + STEP0_NAME + "/" + "{sample}_merged_R1.fastq.gz",
        r2 = OUTDIR + STEP0_NAME + "/" + "{sample}_merged_R2.fastq.gz"
    output:
        r1 = OUTDIR + STEP3_NAME + "/" + "{sample}_merged_withUMI_R1.fastq.gz",
        r2 = OUTDIR + STEP3_NAME + "/" + "{sample}_merged_withUMI_R2.fastq.gz"
    params:
        basename             = "{sample}",
        outdir               = OUTDIR + STEP3_NAME + "/",
        unmapped_bam         = OUTDIR + STEP3_NAME + "/" + "{sample}_unmapped.bam",
        unmapped_bam_withUMI = OUTDIR + STEP3_NAME + "/" + "{sample}_unmapped_withUMI.bam",
        fgbio_params         = config["s3_extract_UMI"]["FGBio_params"],
        module_picard        = config["modules"]["picard"],
        module_fgbio         = config["modules"]["fgbio"]
    shell:
        """
        module load {params.module_picard}
        module load {params.module_fgbio}
        mkdir -p {params.outdir}

        CMD1="java -Xmx4g -jar $PICARD_HOME/picard.jar FastqToSam \
	        -F1 {input.r1} \
	        -F2 {input.r2} \
	        -O {params.unmapped_bam} \
	        -SM {params.basename}"
        eval $CMD1
        
        CMD2="java -Xmx4g -jar $FGBIO_HOME/fgbio-2.0.2.jar ExtractUmisFromBam \
	        -i {params.unmapped_bam} \
	        -o {params.unmapped_bam_withUMI} \
	        {params.fgbio_params}"
        eval $CMD2
        
        CMD3="java -Xmx4g -jar $PICARD_HOME/picard.jar SamToFastq \
	        -I {params.unmapped_bam_withUMI} \
	        -F {output.r1} \
	        -F2 {output.r2}" 
        eval $CMD3
        """

## Step 4: Align reads with kalign (slurm_kalign_umi.sh)
rule s4_read_alignment:
    input:
        r1    = OUTDIR + STEP3_NAME + "/" + "{sample}_merged_withUMI_R1.fastq.gz",
        r2    = OUTDIR + STEP3_NAME + "/" + "{sample}_merged_withUMI_R2.fastq.gz",
        index = rules.s1_mask_repeats.output.index
    output:
        alignment = OUTDIR + STEP4_NAME + "/" + "{sample}_kalign_" + KALIGN_ID + "_alignment.sam"
    params:
        outdir        = OUTDIR + STEP4_NAME + "/",
        kalign_params = config["s4_read_alignment"]["kalign_params"],
        log_file      = OUTDIR + STEP4_NAME + "/" "{sample}_kalign_" + KALIGN_ID + ".log",
        module_kit4b  = config["modules"]["kit4b"]
    shell:
        """
        module load {params.module_kit4b}
        mkdir -p {params.outdir}

        ngskit4b kalign \
            {params.kalign_params} \
	        -i {input.r1} \
	        -u {input.r2} \
	        -I {input.index} \
	        -o {output.alignment} \
	        -T {threads} \
	        -F {params.log_file}
        """

## Step 5: Remove PCR and optical duplicates from alignment with Picard (slurm_depup.sh)
rule s5_alignment_deduplication:
    input:
        alignment = OUTDIR + STEP4_NAME + "/" + "{sample}_kalign_" + KALIGN_ID + "_alignment.sam"
    output:
        dedup_alignment = OUTDIR + STEP5_NAME + "/" + "{sample}_alignment_dedup.bam"
    params:
        outdir        = OUTDIR + STEP5_NAME + "/",
        picard_params = config["s5_alignment_deduplication"]["Picard_params"],
        metrics_file  = OUTDIR + STEP5_NAME + "/" + "{sample}_removeduplicates.metrics.txt",
        module_picard = config["modules"]["picard"]
    shell:
        """
        module load {params.module_picard}
        mkdir -p {params.outdir}

        CMD="java -Xmx4g -jar $PICARD_HOME/picard.jar MarkDuplicates\
            --INPUT {input.alignment} \
            --OUTPUT {output.dedup_alignment} \
            --METRICS_FILE {params.metrics_file} \
            {params.picard_params}"
        eval $CMD
        """

## Step 6a: Generate 2Bit genome with faToTwoBit
rule s6a_two_bit_genome:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        twobit_genome = OUTDIR + STEP6a_NAME + "/" + REF_GENOME_ID + "_alignment_dedup.2bit"
    params:
        outdir = OUTDIR + STEP6a_NAME + "/",
        info   = OUTDIR + STEP6a_NAME + "/" + REF_GENOME_ID + "_info.tab"
    conda:
        "envs/Step6_utils.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        faToTwoBit {input.masked_ref_genome} {output.twobit_genome}
        twoBitInfo {output.twobit_genome} {params.info}
        """

## Step 6b:  Calculate effective genome size with faCount
rule s6b_effective_genome_size:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        eff_gen_size = OUTDIR + STEP6b_NAME + "/" + REF_GENOME_ID + "_effGenSize.txt"
    params:
        outdir  = OUTDIR + STEP6b_NAME + "/"
    conda:
        "envs/Step6_utils.yaml"
    shell:
        """
        mkdir -p {params.outdir}

        faCount {input.masked_ref_genome} > {output.eff_gen_size}
        """

## Step 6c: Compute GC bias with deeptools (slurm_computeGCBias.sh)
rule s6c_compute_GC_bias:
    input:
        dedup_alignment = OUTDIR + STEP5_NAME + "/" + "{sample}_alignment_dedup.bam",
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size
    output:
        freq_file = OUTDIR + STEP6c_NAME + "/" + "{sample}_computeGCbias.txt"
    params:
        outdir          = OUTDIR + STEP6c_NAME + "/", 
        eff_gen_size    = config["s6b_output"]["effective_genome_size"],
        samtools_index  = OUTDIR + STEP5_NAME + "/" + "{sample}_alignment_dedup.bam.bai",
        module_python   = config["modules"]["python"],
        module_samtools = config["modules"]["samtools"]
    shell:
        """
        module load {params.module_python}
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        samtools index {input.dedup_alignment}
        computeGCBias -b {input.dedup_alignment} --effectiveGenomeSize {params.eff_gen_size} -g {input.twobit_genome} --GCbiasFrequenciesFile {output.freq_file}
        """

## Step 6d: Correct GC bias with deeptools (slurm_correctGCBias.sh)
rule s6d_correct_GC_bias:
    input:
        dedup_alignment = OUTDIR + STEP5_NAME + "/" + "{sample}_alignment_dedup.bam",
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size,
        freq_file       = OUTDIR + STEP6c_NAME + "/" + "{sample}_computeGCbias.txt"
    output:
        gc_corrected = OUTDIR + STEP6d_NAME + "/" + "{sample}_alignment_dedup_gcCorrected.bam"
    params:
        outdir          = OUTDIR + STEP6d_NAME + "/", 
        eff_gen_size    = config["s6b_output"]["effective_genome_size"],
        module_python   = config["modules"]["python"],
        module_samtools = config["modules"]["samtools"]
    shell:
        """
        module load {params.module_python}
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        correctGCBias_kalign --bamfile {input.dedup_alignment} --effectiveGenomeSize {params.eff_gen_size} --genome {input.twobit_genome} --GCbiasFrequenciesFile {input.freq_file} -o {output.gc_corrected} -p {threads}
        """

## Step 7a: Calculate alignment statistics with Picard (slurm_sizemetrics.sh)
rule s7a_size_metrics:
    input:
        gc_corrected = OUTDIR + STEP6d_NAME + "/" + "{sample}_alignment_dedup_gcCorrected.bam"
    output:
        size_metrics = OUTDIR + STEP7a_NAME + "/" + REF_SPECIES + "_{sample}_insert_size_metrics.txt",
        histogram    = OUTDIR + STEP7a_NAME + "/"  + REF_SPECIES + "_{sample}_insert_size_histogram.pdf"
    params:
        outdir        = OUTDIR + STEP7a_NAME + "/",
        module_picard = config["modules"]["picard"],
        module_R      = config["modules"]["R"]
    shell:
        """
        module load {params.module_picard}
        module load {params.module_R}
        mkdir -p {params.outdir}

        CMD="java -Xmx4g -jar $PICARD_HOME/picard.jar CollectInsertSizeMetrics \
          -I {input.gc_corrected} \
          -O {output.size_metrics} \
          -H {output.histogram}"
        eval "$CMD"
        """

## Step 7b: Estimate mean nuclear genome coverage (slurm_read_count_GCcorrect.sh)
rule s7b_read_count:
    input:
        gc_corrected = OUTDIR + STEP6d_NAME + "/" + "{sample}_alignment_dedup_gcCorrected.bam"
    output:
        read_count = OUTDIR + STEP7b_NAME + "/" + REF_SPECIES + "_{sample}_count.txt"
    params:
        outdir          = OUTDIR + STEP7b_NAME + "/",
        module_samtools = config["modules"]["samtools"]
    shell:
        """
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        CMD="samtools view -c {input.gc_corrected} -o {output.read_count}"
        eval "$CMD"
        """

## Step 8: Peak analysis using DANPOS3
# Original Slurm script: slurm_dtriple_1_vs_27-29.sh
rule s8_peak_analysis:
    input:
        gc_corrected = OUTDIR + STEP6d_NAME + "/" + "{sample}_alignment_dedup_gcCorrected.bam"
    output:
        dpos_op    = OUTDIR + STEP8_NAME + "/{sample}/dtriple/{sample}-" + INPUT_CONTROL_NAME + ".positions.integrative.xls",
        dpeak_op   = OUTDIR + STEP8_NAME + "/{sample}/dtriple/{sample}-" + INPUT_CONTROL_NAME + ".peaks.integrative.xls",
        dregion_op = OUTDIR + STEP8_NAME + "/{sample}/dtriple/{sample}-" + INPUT_CONTROL_NAME + ".regions.integrative.xls"
    params:
        step8_dir     = OUTDIR + STEP8_NAME,
        sample_dir    = OUTDIR + STEP8_NAME + "/{sample}/",
        exp_dir       = OUTDIR + STEP8_NAME + "/{sample}/{sample}/",
        control_dir   = OUTDIR + STEP8_NAME + "/{sample}/" + INPUT_CONTROL_NAME + "/",
        danpos_dir    = OUTDIR + STEP8_NAME + "/{sample}/dtriple/",
        control_id    = INPUT_CONTROL_SAMPLES,
        module_danpos = config["modules"]["danpos"]
    shell:
        """
        # module load {params.module_danpos}
        # mkdir -p {params.step8_dir}
        # mkdir -p {params.sample_dir}
        # mkdir -p {params.exp_dir}
        # mkdir -p {params.control_dir}
        # mkdir -p {params.danpos_dir}
        #    
        # # TODO Copy files across into their specific dirs
        # # Experiment input (exp/test) = alignment_dedup_gcCorrected (output from Step 6d)
        # # Input control (control) = samples specified in chromatin_assembly_config.yml
        #
        # # Call DANPOS
        # CMD="python danpos.py dtriple {params.exp_dir}:{params.control_dir} -o {params.danpos_dir}"
        # eval "$CMD"

        mkdir -p {params.step8_dir}
        mkdir -p {params.sample_dir}
        mkdir -p {params.danpos_dir}
        touch {output.dpos_op}
        touch {output.dpeak_op}
        touch {output.dregion_op}
        """


