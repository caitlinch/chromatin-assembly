# To run pipeline set chromatin-assembly/ dir as working directory

# --- Config file --- #
configfile: "config/chromatin_assembly_config.yml"


# --- Global Variables --- #
REF_SPECIES=species=config['ref_species']

# SAMPLE_IDS – unique identifiers of reads to process
SAMPLE_IDS  = config['input_samples']


# --- Rule: run_all --- #
## Run all rules
rule run_all:
    input:
        s1_masked  = expand("{repo_dir}results/{species}/{step_name}/{ref_genome_id}.masked", repo_dir=config['repo_dir'], species=config['ref_species'], step_name=config['output_dir']['step1'], ref_genome_id=config['reference_genome_id']),
        s1_index   = expand("{repo_dir}results/{species}/{step_name}/{ref_genome_id}.masked.index", repo_dir=config['repo_dir'], species=config['ref_species'], step_name=config['output_dir']['step1'], ref_genome_id=config['reference_genome_id']),
        s2_r1      = expand("results/{species}/{step_name}/{sample}_merged_R1_fastqc.html", species=config['ref_species'], step_name=config['output_dir']['step2'], sample=SAMPLE_IDS),
        s2_r2      = expand("results/{species}/{step_name}/{sample}_merged_R2_fastqc.html", species=config['ref_species'], step_name=config['output_dir']['step2'], sample=SAMPLE_IDS),
        s3_r1      = expand("results/{species}/{step_name}/{sample}_merged_withUMI_R1.fastq.gz", species=config['ref_species'], step_name=config['output_dir']['step3'], sample=SAMPLE_IDS),
        s3_r2      = expand("results/{species}/{step_name}/{sample}_merged_withUMI_R2.fastq.gz", species=config['ref_species'], step_name=config['output_dir']['step3'], sample=SAMPLE_IDS),
        s4_algnmt  = expand("results/{species}/{step_name}/{sample}_kalign_{kalign_id}_alignment.sam", species=config['ref_species'], step_name=config['output_dir']['step4'], sample=SAMPLE_IDS, kalign_id=config['s4_read_alignment']['kalign_id']),
        s5_dedup   = expand("results/{species}/{step_name}/{sample}_alignment_dedup.bam", species=config['ref_species'], step_name=config['output_dir']['step5'], sample=SAMPLE_IDS),
        s6a_2bit   = expand("results/{species}/{step_name}/{ref_genome_id}_alignment_dedup.2bit", species=config['ref_species'], step_name=config['output_dir']['step6a'], ref_genome_id=config['reference_genome_id']),
        s6b_gSize  = expand("results/{species}/{step_name}/{ref_genome_id}_effGenSize.txt", species=config['ref_species'], step_name=config['output_dir']['step6b'], ref_genome_id=config['reference_genome_id']),
        s6c_GCfreq = expand("results/{species}/{step_name}/{sample}_computeGCbias.txt", species=config['ref_species'], step_name=config['output_dir']['step6c'], sample=SAMPLE_IDS),
        s6d_GCbias = expand("results/{species}/{step_name}/{sample}_alignment_dedup_gcCorrected.bam", species=config['ref_species'], step_name=config['output_dir']['step6d'], sample=SAMPLE_IDS),
        s7a_metric = expand("results/{species}/{step_name}/{ref_species}_{sample}_insert_size_metrics.txt", species=config['ref_species'], step_name=config['output_dir']['step7a'], ref_species=config['ref_species'], sample=SAMPLE_IDS),
        s7b_stats  = expand("results/{species}/{step_name}/{ref_species}_{sample}_count.txt", species=config['ref_species'], step_name=config['output_dir']['step7b'], ref_species=config['ref_species'], sample=SAMPLE_IDS),
        s8_dpos    = expand("results/{species}/{step_name}/{test_name}/dtriple/test-control.positions.integrative.xls", species=config['ref_species'], step_name=config['output_dir']['step8'], test_name=config['peak_analysis']['test_name']),
        s8_dpeak   = expand("results/{species}/{step_name}/{test_name}/dtriple/test-control.peaks.integrative.xls", species=config['ref_species'], step_name=config['output_dir']['step8'], test_name=config['peak_analysis']['test_name']),
        s8_dregion = expand("results/{species}/{step_name}/{test_name}/dtriple/test-control.regions.integrative.xls", species=config['ref_species'], step_name=config['output_dir']['step8'], test_name=config['peak_analysis']['test_name'])


# --- Pipeline steps --- #
## Step 0: Read collation (SLURM_MergeSamples.sh)
rule s0_merge_samples:
    input:
        reads_dir = config['merge_reads']['read_dir']
    output:
        r1 = expand("results/{species}/{step_name}/{sample}_merged_R1.fastq.gz", species=config['ref_species'], step_name=config['output_dir']['step0'], sample=SAMPLE_IDS),
        r2 = expand("results/{species}/{step_name}/{sample}_merged_R2.fastq.gz", species=config['ref_species'], step_name=config['output_dir']['step0'], sample=SAMPLE_IDS)
    log: f"logs/s0_merge_samples.{config['ref_species']}.log"
    params:
        ref_species        = REF_SPECIES,
        use_merge_dict     = config['merge_reads']['use_merge_dict'],
        dict_file          = config['merge_reads']['merge_dict'],
        output_dir         = f"{config['repo_dir']}results/{config['ref_species']}/{config['output_dir']['step0']}",
        log_dir            = f"{config['repo_dir']}logs/{config['output_dir']['step0']}",
        samples            = expand("{sample}", sample=SAMPLE_IDS),
        samples_file       = f"results/{config['ref_species']}/{config['output_dir']['step0']}/sample_names.txt"
    shell:
        """
        # s0_merge_samples

        # Delete existing samples file (if present)
        if test -f {params.samples_file}; then 
            rm {params.samples_file}
        fi

        # Write input samples to file
        for s in {params.samples}; do
            echo "$s" >> {params.samples_file}
        done

        ## Usage:sh S0_MergeSamples.sh species_name samples_file use_merge_dict dict_file reads_dir output_dir log_dir
        sh workflow/scripts/S0_MergeSamples.sh {params.ref_species} \
            {params.samples_file} \
            {params.use_merge_dict} {params.dict_file} \
            {input.reads_dir} \
            {params.output_dir} \
            {params.log_dir}
        """

## Step 1: Repeat masking with RepeatMasker and suffix array (slurm_waterdragon_RM.sh)
# Original suffix array command:  ngskit4b index -i EWD_hifiasm_HiC.fasta.masked -o EWD_hifiasm_HiC.fasta.masked.index -r waterdragon
rule s1_mask_repeats:
    input:
        ref_genome = config['reference_genome_path']
    output:
        masked = f"{config['repo_dir']}results/{config['ref_species']}/{config['output_dir']['step1']}/{config['reference_genome_id']}.masked",
        index = f"{config['repo_dir']}results/{config['ref_species']}/{config['output_dir']['step1']}/{config['reference_genome_id']}.masked.index"
    log: f"{config['repo_dir']}logs/s1_mask_repeats.{config['ref_species']}.log"
    params:
        outdir              = lambda w, output: os.path.split(output.masked)[0],
        ref_genome_basename = lambda w, input: os.path.split(input.ref_genome)[1],
        ngskit4b_log        = f"{config['repo_dir']}results/{config['ref_species']}/{config['output_dir']['step1']}/{config['reference_genome_id']}.masked.index.log",
        adapter             = f"{config['repo_dir']}{config['params']['adapters']}",
        repeatmasker_engine = config['s1_mask_repeats']['repeatmasker_engine'],
        species_name        = config['binomial_species_name'], 
        module_repeatmasker = config['modules']['repeatmasker'],
        module_kit4b        = config['modules']['kit4b']
    shell:
        """
        # s1_mask_repeats
        module load {params.module_repeatmasker}
        module load {params.module_kit4b}
        mkdir -p {params.outdir}
        cd {params.outdir}

        RepeatMasker -pa {threads} -dir {params.outdir} -qq -lib {params.adapter} {input.ref_genome} {params.repeatmasker_engine}

        # Copy and rename RepeatMasker output with human-readable name
        cp {params.ref_genome_basename}.masked {output.masked}

        ngskit4b index -i {output.masked} -o {output.index} -r '{params.species_name}' -T {threads} -F {params.ngskit4b_log}
        """

## Step 2: Perform quality control using FastQC (slurm_fastqc.sh)
rule s2_raw_read_QC:
    input:
        r1 = f"results/{config['ref_species']}/{config['output_dir']['step0']}/{{sample}}_merged_R1.fastq.gz",
        r2 = f"results/{config['ref_species']}/{config['output_dir']['step0']}/{{sample}}_merged_R2.fastq.gz"
    output:
        r1 = f"results/{config['ref_species']}/{config['output_dir']['step2']}/{{sample}}_merged_R1_fastqc.html",
        r2 = f"results/{config['ref_species']}/{config['output_dir']['step2']}/{{sample}}_merged_R2_fastqc.html"
    log: "logs/s2_raw_read_QC.{sample}.log"
    params:
        outdir        = lambda w, output: os.path.split(output.r1)[0],
        module_fastqc = config['modules']['fastqc']
    shell:
        """
        # s2_raw_read_QC
        module load {params.module_fastqc}
        mkdir -p {params.outdir}

        fastqc -t {threads} {input.r1} {input.r2} -o {params.outdir}
        """

## Step 3: UMI extraction with FGBio and Picard (slurm_extractUMI.sh)
rule s3_extract_UMI:
    input:
        r1 = f"results/{config['ref_species']}/{config['output_dir']['step0']}/{{sample}}_merged_R1.fastq.gz",
        r2 = f"results/{config['ref_species']}/{config['output_dir']['step0']}/{{sample}}_merged_R2.fastq.gz"
    output:
        r1 = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_merged_withUMI_R1.fastq.gz",
        r2 = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_merged_withUMI_R2.fastq.gz"
    log: "logs/s3_extract_UMI.{sample}.log"
    params:
        basename             = "{sample}",
        outdir               = lambda w, output: os.path.split(output.r1)[0],
        unmapped_bam         = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_unmapped.bam",
        unmapped_bam_withUMI = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_unmapped_withUMI.bam",
        fgbio_params         = config['s3_extract_UMI']['FGBio_params'],
        module_picard        = config['modules']['picard'],
        module_fgbio         = config['modules']['fgbio']
    shell:
        """
        # s3_extract_UMI
        module load {params.module_picard}
        module load {params.module_fgbio}
        mkdir -p {params.outdir}

        CMD1="java -Xmx4g -jar $PICARD_HOME/picard.jar FastqToSam -F1 {input.r1} -F2 {input.r2} -O {params.unmapped_bam} -SM {params.basename}"
        eval $CMD1

        CMD2="java -Xmx4g -jar $FGBIO_HOME/fgbio-2.0.2.jar ExtractUmisFromBam -i {params.unmapped_bam} -o {params.unmapped_bam_withUMI} {params.fgbio_params}"
        eval $CMD2

        CMD3="java -Xmx4g -jar $PICARD_HOME/picard.jar SamToFastq -I {params.unmapped_bam_withUMI} -F {output.r1} -F2 {output.r2}" 
        eval $CMD3
        """

## Step 4: Align reads with kalign (slurm_kalign_umi.sh)
rule s4_read_alignment:
    input:
        r1 = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_merged_withUMI_R1.fastq.gz",
        r2 = f"results/{config['ref_species']}/{config['output_dir']['step3']}/{{sample}}_merged_withUMI_R2.fastq.gz",
        index = rules.s1_mask_repeats.output.index
    output:
        alignment = f"results/{config['ref_species']}/{config['output_dir']['step4']}/{{sample}}_kalign_{config['s4_read_alignment']['kalign_id']}_alignment.sam"
    log: "logs/s4_read_alignment.{sample}.log"
    params:
        outdir        = lambda w, output: os.path.split(output.alignment)[0],
        log_file      = f"results/{config['ref_species']}/{config['output_dir']['step4']}/{{sample}}_kalign_{config['s4_read_alignment']['kalign_id']}_alignment.log",
        kalign_params = config['s4_read_alignment']['kalign_params'],
        module_kit4b  = config['modules']['kit4b']
    shell:
        """
        # s4_read_alignment
        module load {params.module_kit4b}
        mkdir -p {params.outdir}

        ngskit4b kalign {params.kalign_params} -i {input.r1} -u {input.r2} -I {input.index} -o {output.alignment} -T {threads} -F {params.log_file}
        """

## Step 5: Remove PCR and optical duplicates from alignment with Picard (slurm_depup.sh)
rule s5_alignment_deduplication:
    input:
        alignment = f"results/{config['ref_species']}/{config['output_dir']['step4']}/{{sample}}_kalign_{config['s4_read_alignment']['kalign_id']}_alignment.sam"
    output:
        dedup_alignment = f"results/{config['ref_species']}/{config['output_dir']['step5']}/{{sample}}_alignment_dedup.bam"
    log: "logs/s5_alignment_deduplication.{sample}.log"
    params:
        outdir        = lambda w, output: os.path.split(output.dedup_alignment)[0],
        metrics       = f"results/{config['ref_species']}/{config['output_dir']['step5']}/{{sample}}_removeduplicates.metrics.txt",
        picard_params = config['s5_alignment_deduplication']['Picard_params'],
        module_picard = config['modules']['picard']
    shell:
        """
        # s5_alignment_deduplication
        module load {params.module_picard}
        mkdir -p {params.outdir}

        CMD="java -Xmx4g -jar $PICARD_HOME/picard.jar MarkDuplicates --INPUT {input.alignment} --OUTPUT {output.dedup_alignment} --METRICS_FILE {params.metrics} {params.picard_params}"
        eval $CMD
        """

## Step 6a: Generate 2Bit genome with faToTwoBit
rule s6a_two_bit_genome:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        twobit_genome = f"results/{config['ref_species']}/{config['output_dir']['step6a']}/{config['reference_genome_id']}_alignment_dedup.2bit"
    log: f"logs/s6a_two_bit_genome.{config['ref_species']}.log"
    params:
        outdir            = lambda w, output: os.path.split(output.twobit_genome)[0],
        info              = f"results/{config['ref_species']}/{config['output_dir']['step6a']}/{config['reference_genome_id']}_info.tab"
    conda:
        "envs/Step6.yaml"
    shell:
        """
        # s6a_two_bit_genome
        mkdir -p {params.outdir}

        faToTwoBit {input.masked_ref_genome} {output.twobit_genome}
        twoBitInfo {output.twobit_genome} {params.info}
        """

## Step 6b:  Calculate effective genome size with faCount
rule s6b_effective_genome_size:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        eff_gen_size = f"results/{config['ref_species']}/{config['output_dir']['step6b']}/{config['reference_genome_id']}_effGenSize.txt"
    log: f"logs/s6b_effective_genome_size.{config['ref_species']}.log"
    params:
        outdir = lambda w, output: os.path.split(output.eff_gen_size)[0]
    conda:
        "envs/Step6.yaml"
    shell:
        """
        # s6b_effective_genome_size
        mkdir -p {params.outdir}

        faCount {input.masked_ref_genome} > {output.eff_gen_size}
        """

## Step 6c: Compute GC bias with deeptools (slurm_computeGCBias.sh)
rule s6c_compute_GC_bias:
    input:
        dedup_alignment = f"results/{config['ref_species']}/{config['output_dir']['step5']}/{{sample}}_alignment_dedup.bam",
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size
    output:
        freq_file = f"results/{config['ref_species']}/{config['output_dir']['step6c']}/{{sample}}_computeGCbias.txt"
    log: "logs/s6c_compute_GC_bias.{sample}.log"
    params:
        outdir          = lambda w, output: os.path.split(output.freq_file)[0], 
        samtools_index  = f"results/{config['ref_species']}/{config['output_dir']['step5']}/{{sample}}_alignment_dedup.bam.bai",
        eff_gen_size    = config['effective_genome_size'],
        module_python   = config['modules']['python'],
        module_samtools = config['modules']['samtools']
    shell:
        """
        # s6c_compute_GC_bias
        module load {params.module_python}
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        samtools index {input.dedup_alignment}
        computeGCBias -b {input.dedup_alignment} --effectiveGenomeSize {params.eff_gen_size} -g {input.twobit_genome} --GCbiasFrequenciesFile {output.freq_file}
        """

## Step 6d: Correct GC bias with deeptools (slurm_correctGCBias.sh)
rule s6d_correct_GC_bias:
    input:
        dedup_alignment = f"results/{config['ref_species']}/{config['output_dir']['step5']}/{{sample}}_alignment_dedup.bam",
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size,
        freq_file       = f"results/{config['ref_species']}/{config['output_dir']['step6c']}/{{sample}}_computeGCbias.txt"
    output:
        gc_corrected = f"results/{config['ref_species']}/{config['output_dir']['step6d']}/{{sample}}_alignment_dedup_gcCorrected.bam"
    log: "logs/s6d_correct_GC_bias.{sample}.log"
    params:
        outdir          = lambda w, output: os.path.split(output.gc_corrected)[0], 
        eff_gen_size    = config['effective_genome_size'],
        module_python   = config['modules']['python'],
        module_samtools = config['modules']['samtools']
    shell:
        """
        # s6d_correct_GC_bias
        module load {params.module_python}
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        correctGCBias_kalign --bamfile {input.dedup_alignment} --effectiveGenomeSize {params.eff_gen_size} --genome {input.twobit_genome} --GCbiasFrequenciesFile {input.freq_file} -o {output.gc_corrected} -p {threads}
        samtools index {output.gc_corrected}
        """

## Step 7a: Calculate alignment statistics with Picard (slurm_sizemetrics.sh)
rule s7a_size_metrics:
    input:
        gc_corrected = f"results/{config['ref_species']}/{config['output_dir']['step6d']}/{{sample}}_alignment_dedup_gcCorrected.bam"
    output:
        size_metrics = f"results/{config['ref_species']}/{config['output_dir']['step7a']}/{config['ref_species']}_{{sample}}_insert_size_metrics.txt",
        histogram    = f"results/{config['ref_species']}/{config['output_dir']['step7a']}/{config['ref_species']}_{{sample}}_insert_size_histogram.pdf"
    log: "logs/s7a_size_metrics.{sample}.log"
    params:
        outdir        = lambda w, output: os.path.split(output.size_metrics)[0], 
        module_picard = config['modules']['picard'],
        module_R      = config['modules']['R']
    shell:
        """
        # s7a_size_metrics
        module load {params.module_picard}
        module load {params.module_R}
        mkdir -p {params.outdir}

        CMD="java -Xmx4g -jar $PICARD_HOME/picard.jar CollectInsertSizeMetrics -I {input.gc_corrected} -O {output.size_metrics} -H {output.histogram}"
        eval "$CMD"
        """

## Step 7b: Estimate mean nuclear genome coverage (slurm_read_count_GCcorrect.sh)
rule s7b_read_count:
    input:
        gc_corrected = f"results/{config['ref_species']}/{config['output_dir']['step6d']}/{{sample}}_alignment_dedup_gcCorrected.bam"
    output:
        read_count = f"results/{config['ref_species']}/{config['output_dir']['step7b']}/{config['ref_species']}_{{sample}}_count.txt"
    log: "logs/s7b_read_count.{sample}.log"
    params:
        outdir          = lambda w, output: os.path.split(output.read_count)[0], 
        module_samtools = config['modules']['samtools']
    shell:
        """
        # s7b_read_count
        module load {params.module_samtools}
        mkdir -p {params.outdir}

        CMD="samtools view -c {input.gc_corrected} -o {output.read_count}"
        eval "$CMD"
        """

## Step 8: Peak analysis using DANPOS3
# Original Slurm script: slurm_dtriple_1_vs_27-29.sh
rule s8_peak_analysis:
    input:
        test_als    = expand("results/{species}/{step_name}/{exp_samples}_alignment_dedup_gcCorrected.bam", species=config['ref_species'], step_name=config['output_dir']['step6d'], exp_samples=config['peak_analysis']['exp_ids']),
        control_als = expand("results/{species}/{step_name}/{control_samples}_alignment_dedup_gcCorrected.bam", species=config['ref_species'], step_name=config['output_dir']['step6d'], control_samples=config['peak_analysis']['control_ids'])
    output:
        dpos_op    = f"results/{config['ref_species']}/{config['output_dir']['step8']}/{config['peak_analysis']['test_name']}/dtriple/test-control.positions.integrative.xls",
        dpeak_op   = f"results/{config['ref_species']}/{config['output_dir']['step8']}/{config['peak_analysis']['test_name']}/dtriple/test-control.peaks.integrative.xls",
        dregion_op = f"results/{config['ref_species']}/{config['output_dir']['step8']}/{config['peak_analysis']['test_name']}/dtriple/test-control.regions.integrative.xls"
    log: f"logs/s8_peak_analysis.{config['peak_analysis']['test_name']}.log"
    params:
        test_indexes    = expand("results/{species}/{step_name}/{exp_samples}_alignment_dedup_gcCorrected.bam", species=config['ref_species'], step_name=config['output_dir']['step6d'], exp_samples=config['peak_analysis']['exp_ids']),
        control_indexes = expand("results/{species}/{step_name}/{control_samples}_alignment_dedup_gcCorrected.bam", species=config['ref_species'], step_name=config['output_dir']['step6d'], control_samples=config['peak_analysis']['control_ids']),
        analysis_dir    = lambda w, output: os.path.split(os.path.split(output.dpos_op)[0])[0], 
        danpos_op_dir   = lambda w, output: os.path.split(output.dpos_op)[0],
        test_dir        = f"results/{config['ref_species']}/{config['output_dir']['step8']}/{config['peak_analysis']['test_name']}/test/",
        control_dir     = f"results/{config['ref_species']}/{config['output_dir']['step8']}/{config['peak_analysis']['test_name']}/control/",
        module_danpos   = config['modules']['danpos'],
        module_python   = config['modules']['python']    
    shell:
        """
        # s8_peak_analysis
        module load {params.module_python}
        module load {params.module_danpos}

        mkdir -p {params.analysis_dir}
        mkdir -p {params.danpos_op_dir}
        mkdir -p {params.test_dir}
        mkdir -p {params.control_dir}
        
        cp {input.test_als} {params.test_dir}
        cp {params.test_indexes} {params.test_dir}

        cp {input.control_als} {params.control_dir}
        cp {params.control_indexes} {params.control_dir}

        CMD="python danpos.py dtriple {params.test_dir}:{params.control_dir} -o {params.danpos_op_dir}"
        eval "$CMD"
        """

