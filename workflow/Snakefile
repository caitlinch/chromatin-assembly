# --- Config file --- #
configfile: "config/test_config.yml"


# --- Global Variables --- #
OUTDIR = "results/" + config["input"]["reference_species"] + "/"

# --- Complete pipeline run --- #
# Run all rules
rule run_all:
    input:
        "results/step7a_sizeMetrics.txt",
        "results/step7b_summaryStatistics.txt",
        "results/step8_DANPOS.txt"


# --- Pipeline steps --- #
## mask_repeats: Masking with RepeatMasker (Step 1)
# Step 1: Repeat masking and suffix array
# Original Slurm script: slurm_waterdragon_RM.sh
# Original suffix array command:  ngskit4b index -i EWD_hifiasm_HiC.fasta.masked -o EWD_hifiasm_HiC.fasta.masked -r waterdragon
rule s1_mask_repeats:
    input:
        fasta = config["input"]["reference_genome_filepath"]
    output:
        masked = OUTDIR +  config["step1"]["name"] + "/" + "masked_ref_genome.fasta",
        index = OUTDIR +  config["step1"]["name"] + "/" + "index_masked_ref_genome.fasta",
        index_log = OUTDIR + config["step1"]["name"] + "/" + "index_logs.log"
    params:
        step1_dir = OUTDIR + config["step1"]["name"] "/"
        adapter = config["params"]["adapters"],
        ref_species = config["input"]["reference_species"]
    threads: config["step1"]["slurm_cpus"]
    shell:
        """
        module load repeatmasker/4.1.0
        module load kit4b/200218
        RepeatMasker -pa config["step1"]["slurm_cpus"] -qq -dir {params.step1_dir} -lib {params.adapter} {input.fasta}
        ngskit4b index -i {output.masked} -o {output.index} -r {params.ref_species} -T config["step1"]["slurm_cpus"] -F {output.index_log}
        """
        
""" 
# Step 1: Original code
WORK_DIR="/datasets/work/efsp-faire/work/sti089"
INPUT_DIR="${WORK_DIR}/genomes/water_dragon"
OUT_DIR="${INPUT_DIR}/RM"
LIB_DIR="${WORK_DIR}/adapters"
module load repeatmasker/4.1.0
/bin/date
CMD="RepeatMasker -pa ${SLURM_CPUS_PER_TASK} -qq -dir ${OUT_DIR} -lib ${LIB_DIR}/adap_cont_rna.fa  ${INPUT_DIR}/EWD_hifiasm_HiC.fasta"
echo "Executing command [$CMD]..."
eval "$CMD"
echo '  ...completed'
/bin/date 
"""


## raw_read_QC: Perform quality control using FastQC (Step 2)
# Step 2: Raw read QC
rule s2_raw_read_QC:
    input:
        r1 = config["input"]["input_dir"] + config["input"]["input_pattern"] + "{num}_R1.fastq.gz",
        r2 = config["input"]["input_dir"] + config["input"]["input_pattern"] + "{num}_R2.fastq.gz"
    output:
        r1_zip =  OUTDIR +  config["step2"]["name"] + "/" + config["input"]["input_pattern"] + "{num}_R1.fastq.gz",
        r2_zip =  OUTDIR +  config["step2"]["name"] + "/" + config["input"]["input_pattern"] + "{num}_R2.fastq.gz"
    threads: config["step2"]["slurm_cpus"]
    shell:
        """
        cat {input.r1} > {output.r1_zip}
        cat {input.r2} > {output.r2_zip}
        """

"""
Step 2 shell command:
    module load fastqc/0.11.9 
    fastqc -t 2 {input.r1} {input.r2} -o {params.outdir}
"""

"""
test Step 2 shell command
        module load fastqc/0.11.9
        echo 'Step 2' >> {output.zip1}
        echo 'Step 2' >> {output.zip2}
"""

""" 
# Original script
WORK_DIR="/scratch3/sti089/ACC_Pvitticeps_June2022"
FASTQC_DIR="${WORK_DIR}/fastqc"
READS_DIR="${WORK_DIR}/orig_reads"
RESULTS_DIR="${FASTQC_DIR}"
module load fastqc/0.11.9 
CMD="fastqc -t 2 ${READS_DIR}/${SLURM_ARRAY_TASK_ID}_*_R1.fastq ${READS_DIR}/${SLURM_ARRAY_TASK_ID}_*_R2.fastq -o ${RESULTS_DIR}"
echo "Executing command [$CMD]..."
eval "$CMD"
echo '	...completed'
"""

