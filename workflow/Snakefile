## Caitlin's notes
# Run script from dir that contains chromatin-assembly dir (not from within chromatin-assembly/)

# --- Config file --- #
configfile: "config/chromatin_assembly_config.yml"


# --- Global Variables --- #
REF_SPECIES = config["ref_species"]
OUTDIR      = config["repo_dir"] + "results/" + config["ref_species"] + "/"
SAMPLE      = config["input"]["sample"]

REF_GENOME_ID = config["input"]["reference_genome_id"]

READ_DIR    = config["repo_dir"] + config["merge_reads"]["read_dir"]
READ_SAMPLE = config["merge_reads"]["read_path_pattern"]
READ_LANES  = config["merge_reads"]["read_lanes"]

KALIGN_ID = config["s4_read_alignment"]["kalign_id"]

ADAPTERS = config["repo_dir"] + config["params"]["adapters"]
FACOUNT = config["repo_dir"] + config["params"]["faCount"]
FATOTWOBIT = config["repo_dir"] + config["params"]["faToTwoBit"]


# --- Complete pipeline run --- #
# Run all rules
rule run_all:
    input:
        s1_masked  = OUTDIR + config["output_dir"]["step1"] + "/" + REF_GENOME_ID + ".masked",
        s1_index  = OUTDIR + config["output_dir"]["step1"] + "/" + REF_GENOME_ID + ".masked.index",
        s2_r1      = OUTDIR + config["output_dir"]["step2"] + "/" + SAMPLE + "_fastqc_R1.fastq.html",
        s2_r2      = OUTDIR + config["output_dir"]["step2"] + "/" + SAMPLE + "_fastqc_R2.fastq.html",
        s3_r1      = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_withUMI_R1.fastq.gz",
        s3_r2      = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_withUMI_R2.fastq.gz",
        s4_algnmt  = OUTDIR + config["output_dir"]["step4"] + "/" + SAMPLE + "_kalign_" + KALIGN_ID + "_alignment.sam",
        s5_dedup   = OUTDIR + config["output_dir"]["step5"] + "/" + SAMPLE + "alignment_dedup.bam",
        s6a_2bit   = OUTDIR + config["output_dir"]["step6a"] + "/" + SAMPLE + "_TwoBitGenome.2bit",
        s6b_gSize  = OUTDIR + config["output_dir"]["step6b"] + "/" + SAMPLE + "_effGenSize.txt",
        s6c_GCfreq = OUTDIR + config["output_dir"]["step6c"] + "/" + SAMPLE + "_computeGCbias.txt",
        s6d_GCbias = OUTDIR + config["output_dir"]["step6d"] + "/" + SAMPLE + "_alignment_dedup_gcCorrected.bam",
        s7a_metric = OUTDIR + config["output_dir"]["step7a"] + "/" + REF_SPECIES + "_" + SAMPLE + "_insert_size_metrics.txt",
        s7b_stats  = OUTDIR + config["output_dir"]["step7b"] + "/" + REF_SPECIES + "_" + SAMPLE + "_count.txt",
        s8_danpos  = OUTDIR + config["output_dir"]["step8"] + "/" + REF_SPECIES + "_" + SAMPLE + "_DANPOS.txt"

# --- Pipeline steps --- #
## Step 0: Read collation (SLURM_MergeSamples.sh)
rule s0_merge_samples:
    input:
        r1s = expand("{read_dir}{sample}_L00{lane}_R1.fastq.gz", read_dir = READ_DIR, sample = READ_SAMPLE, lane = READ_LANES),
        r2s = expand("{read_dir}{sample}_L00{lane}_R2.fastq.gz", read_dir = READ_DIR, sample = READ_SAMPLE, lane = READ_LANES)
    output:
        r1_merged = OUTDIR + config["output_dir"]["step0"] + "/" + SAMPLE + "_merged_R1.fastq.gz",
        r2_merged = OUTDIR + config["output_dir"]["step0"] + "/" + SAMPLE + "_merged_R2.fastq.gz"
    params:
        merge_reads = config["merge_reads"]["perform_merge"]
    shell:
        """
        if {params.merge_reads} == TRUE:
            cat {input.r1s} > {output.r1_merged}
            cat {input.r2s} > {output.r2_merged}
        """

## Step 1: Repeat masking with RepeatMasker and suffix array (slurm_waterdragon_RM.sh)
# Original suffix array command:  ngskit4b index -i EWD_hifiasm_HiC.fasta.masked -o EWD_hifiasm_HiC.fasta.masked -r waterdragon
rule s1_mask_repeats:
    input:
        ref_genome = config["input"]["reference_genome_path"]
    output:
        masked = OUTDIR + config["output_dir"]["step1"] + "/" + REF_GENOME_ID + ".masked",
        index  = OUTDIR + config["output_dir"]["step1"] + "/" + REF_GENOME_ID + ".masked.index"
    params:
        outdir      = OUTDIR + config["output_dir"]["step1"] + "/",
        adapter     = ADAPTERS,
        ref_species = REF_SPECIES, 
        log         = OUTDIR + config["output_dir"]["step1"] + "/index_logs.log"
    shell:
        """
        # touch {output.masked}
        # touch {params.log}
        # touch {output.index}

        module load repeatmasker/4.1.2p1
        module load kit4b/200218

        mkdir -p {params.outdir}

        RepeatMasker -pa {threads} -qq -dir {params.outdir} -lib {params.adapter} {input.ref_genome} -engine ncbi
        ngskit4b index -i {output.masked} -o {output.index} -r '{params.ref_species}' -T {threads} -F {params.log}
        """

## Step 2: Perform quality control using FastQC (slurm_fastqc.sh)
rule s2_raw_read_QC:
    input:
        r1 = config["input"]["r1"],
        r2 = config["input"]["r2"]
    output:
        r1 = OUTDIR + config["output_dir"]["step2"] + "/" + SAMPLE + "_fastqc_R1.fastq.html",
        r2 = OUTDIR + config["output_dir"]["step2"] + "/" + SAMPLE + "_fastqc_R2.fastq.html"
    params:
        outdir = OUTDIR + config["output_dir"]["step2"] + "/"
    shell:
        """
        # touch {output.r1}
        # touch {output.r2}

        module load fastqc/0.11.9 

        mkdir -p {params.outdir}

        fastqc -t {threads} {input.r1} {input.r2} -o {params.outdir}
        """

## Step 3: UMI extraction with FGBio and Picard (slurm_extractUMI.sh)
rule s3_extract_UMI:
    input:
        r1 = config["input"]["r1"],
        r2 = config["input"]["r2"]
    output:
        r1 = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_withUMI_R1.fastq.gz",
        r2 = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_withUMI_R2.fastq.gz"
    params:
        basename             = SAMPLE,
        outdir               = OUTDIR + config["output_dir"]["step3"] + "/",
        unmapped_bam         = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_unmapped.bam",
        unmapped_bam_withUMI = OUTDIR + config["output_dir"]["step3"] + "/" + SAMPLE + "_unmapped_withUMI.bam",
        fgbio_params         = config["s3_extract_UMI"]["FGBio_params"]
    shell:
        """
        # touch {output.r1}
        # touch {output.r2}

        module load picard
        module load fgbio/1.3.0

        mkdir -p {params.outdir}
        
        CMD1 = "JAVAOPTS=-Xmx2g java -jar $PICARD_HOME/picard.jar FastqToSam \
	      F1={input.r1} \
	      F2={input.r2} \
	      O={params.unmapped_bam} \
	      SM={params.basename}"
        eval "$CMD1"
        
        CMD2 = "JAVAOPTS=-Xmx50g java -jar $FGBIO_HOME/fgbio-1.3.0.jar ExtractUmisFromBam \
	      --input={params.unmapped_bam} \
	      --output={params.unmapped_bam_withUMI} \
	    	{params.fgbio_params}"
        eval "$CMD2"
        
        CMD3="JAVAOPTS=-Xmx2g java -jar $PICARD_HOME/picard.jar SamToFastq \
	      I={params.unmapped_bam_withUMI} \
	      F={output.r1} \
	      F2={output.r2}" 
        eval "$CMD3"
        """

## Step 4: Align reads with kalign (slurm_kalign_umi.sh)
rule s4_read_alignment:
    input:
        r1    = rules.s3_extract_UMI.output.r1,
        r2    = rules.s3_extract_UMI.output.r2,
        index = rules.s1_mask_repeats.output.index
    output:
        alignment = OUTDIR + config["output_dir"]["step4"] + "/" + SAMPLE + "_kalign_" + KALIGN_ID + "_alignment.sam"
    params:
        outdir        = OUTDIR + config["output_dir"]["step4"] + "/",
        kalign_params = config["s4_read_alignment"]["kalign_params"],
        log_file      = OUTDIR + config["output_dir"]["step4"] + "/" + SAMPLE + "_kalign_" + KALIGN_ID + ".log"
    shell:
        """
        # echo 'Step 4' >> {output.alignment}

        module load kit4b/200218

        mkdir -p {params.outdir}

        CMD="ngskit4b kalign \
            {params.kalign_params} \
	        --in={input.r1} \
	        --pair={input.r2} \
	        --sfx={input.index} \
	        --out={output.alignment} \
	        --threads={threads} \
	        --log={params.log_file}"
        eval "$CMD"
        """

## Step 5: Remove PCR and optical duplicates from alignment with Picard (slurm_depup.sh)
rule s5_alignment_deduplication:
    input:
        alignment = rules.s4_read_alignment.output.alignment
    output:
        dedup_alignment = OUTDIR + config["output_dir"]["step5"] + "/" + SAMPLE + "alignment_dedup.bam"
    params:
        outdir        = OUTDIR + config["output_dir"]["step5"] + "/",
        picard_params = config["s5_alignment_deduplication"]["Picard_params"],
        metrics_file = OUTDIR + config["output_dir"]["step5"] + "/" + SAMPLE + "_removeduplicates.metrics.txt"
    shell:
        """
        # echo 'Step 5' >> {output.dedup_alignment}

        module load picard/2.26.10

        mkdir -p {params.outdir}

        CMD="JAVAOPTS=-Xmx100g java -jar $PICARD_HOME/picard.jar MarkDuplicates\
            I= {input.alignment} \
            O= {output.dedup_alignment} \
            M= {params.metrics_file} \
            {params.picard_params}"
        eval "$CMD"
        """

## Step 6a: Generate 2Bit genome with faToTwoBit
rule s6a_two_bit_genome:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        twobit_genome = OUTDIR + config["output_dir"]["step6a"] + "/" + SAMPLE + "_TwoBitGenome.2bit"
    params:
        outdir     = OUTDIR + config["output_dir"]["step6a"] + "/", 
        faToTwoBit = FATOTWOBIT
    shell:
        """
        # echo 'Step 6a' >> {output.twobit_genome}
        
        mkdir -p {params.outdir}

        ./{params.faToTwoBit} {input.masked_ref_genome} {output.twobit_genome}
        """

## Step 6b:  Calculate effective genome size with faCount
rule s6b_effective_genome_size:
    input:
        masked_ref_genome = rules.s1_mask_repeats.output.masked
    output:
        eff_gen_size = OUTDIR + config["output_dir"]["step6b"] + "/" + SAMPLE + "_effGenSize.txt"
    params:
        outdir  = OUTDIR + config["output_dir"]["step6b"] + "/", 
        faCount = FACOUNT
    shell:
        """
        # echo 'Step 6b' >> {output.eff_gen_size}

        mkdir -p {params.outdir}

        ./{params.faCount} {input.masked_ref_genome} > {output.eff_gen_size}
        """

## Step 6c: Compute GC bias with deeptools (slurm_computeGCBias.sh)
rule s6c_compute_GC_bias:
    input:
        dedup_alignment = rules.s5_alignment_deduplication.output.dedup_alignment,
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size
    output:
        freq_file = OUTDIR + config["output_dir"]["step6c"] + "/" + SAMPLE + "_computeGCbias.txt"
    params:
        outdir          = OUTDIR + config["output_dir"]["step6c"] + "/", 
        eff_gen_size    = config["s6b_output"]["effective_genome_size"]
    shell:
        """
        # echo 'Step 6c' >> {output.freq_file}

        module load python/3.9.4
        module load samtools/1.12

        mkdir -p {params.outdir}

        CMD="computeGCBias \
            -b {input.dedup_alignment} \
            --effectiveGenomeSize {params.eff_gen_size} \
            -g {input.twobit_genome} \
            --GCbiasFrequenciesFile {output.freq_file}"
        eval "$CMD"
        """

## Step 6d: Correct GC bias with deeptools (slurm_correctGCBias.sh)
rule s6d_correct_GC_bias:
    input:
        dedup_alignment = rules.s5_alignment_deduplication.output.dedup_alignment,
        twobit_genome   = rules.s6a_two_bit_genome.output.twobit_genome,
        eff_gen_size    = rules.s6b_effective_genome_size.output.eff_gen_size,
        freq_file       = rules.s6c_compute_GC_bias.output.freq_file
    output:
        gc_corrected = OUTDIR + config["output_dir"]["step6d"] + "/" + SAMPLE + "_alignment_dedup_gcCorrected.bam"
    params:
        outdir       = OUTDIR + config["output_dir"]["step6d"] + "/", 
        eff_gen_size = config["s6b_output"]["effective_genome_size"]
    shell:
        """
        # echo 'Step 6d' >> {output.gc_corrected}

        module load python/3.9.4
        module load samtools/1.12

        mkdir -p {params.outdir}

        CMD = "correctGCBias_kalign \
          -p {threads} \ 
          -b {input.dedup_alignment} \
          --effectiveGenomeSize {params.eff_gen_size} \ 
          -g {input.twobit_genome} \
          --GCbiasFrequenciesFile {input.freq_file} \
          -o {output.gc_corrected}"
        eval "$CMD"
        """

## Step 7a: Calculate alignment statistics with Picard (slurm_sizemetrics.sh)
rule s7a_size_metrics:
    input:
        gc_corrected = rules.s6d_correct_GC_bias.output.gc_corrected
    output:
        size_metrics = OUTDIR + config["output_dir"]["step7a"] + "/" + REF_SPECIES + "_" + SAMPLE + "_insert_size_metrics.txt",
        histogram    = OUTDIR + config["output_dir"]["step7a"] + "/"  + REF_SPECIES + "_" + SAMPLE + "_insert_size_histogram.pdf"
    params:
        outdir = OUTDIR + config["output_dir"]["step7a"] + "/"
    shell:
        """
        # echo 'Step 7a' >> {output.size_metrics}

        module load picard/2.26.10
        module load R/4.0.5

        mkdir -p {params.outdir}

        CMD = "JAVAOPTS=-Xmx20g java -jar $PICARD_HOME/picard.jar CollectInsertSizeMetrics \
          I={input.gc_corrected} \
          O={output.size_metrics} \
          H={output.histogram}"
        eval "$CMD"
        """

## Step 7b: Estimate mean nuclear genome cover with Picard (slurm_read_count_GCcorrect.sh)
rule s7b_read_count:
    input:
        gc_corrected = rules.s6d_correct_GC_bias.output.gc_corrected
    output:
        read_count = OUTDIR + config["output_dir"]["step7b"] + "/" + REF_SPECIES + "_" + SAMPLE + "_count.txt"
    params:
        outdir = OUTDIR + config["output_dir"]["step7b"] + "/"
    shell:
        """
        # echo 'Step 7b' >> {output.read_count}

        module load samtools/1.12

        mkdir -p {params.outdir}

        CMD="samtools view -c {input.gc_corrected} -o {output.read_count}"
        eval "$CMD"
        """

## Step 8: Peak analysis using DANPOS3
# Original Slurm script: slurm_dtriple_1_vs_27-29.sh
rule s8_peak_analysis:
    input:
        gc_corrected = rules.s6d_correct_GC_bias.output.gc_corrected
    output:
        danpos_op = OUTDIR + config["output_dir"]["step8"] + "/" + REF_SPECIES + "_" + SAMPLE + "_DANPOS.txt"
    params:
        outdir = OUTDIR + config["output_dir"]["step8"] + "/"
    shell:
        """
        # module load danpos/3.1.1
        #
        # mkdir -p {params.outdir}
        #
        # CMD="python danpos.py dtriple TEST_DIR:INPUT_DIR -o RESULTS_DIR"
        # eval "$CMD"
        echo 'Step 8 rule test' >> {output.danpos_op}
        """


